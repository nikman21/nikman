---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteConfig } from "@/config";
import { structuredDataGraph, type JsonLdEntity } from "@/lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  canonicalPath?: string;
  structuredData?: JsonLdEntity;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.image,
  type = "website",
  noindex = false,
  canonicalPath,
  structuredData,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const jsonLd = structuredData ?? structuredDataGraph(Astro.site);
const serializedJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#F2EDE2" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="author" href="/about/" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nik Manuel | Essays"
      href="/rss.xml"
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={serializedJsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-shell">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
