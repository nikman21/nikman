---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CurrentSnapshot from "@/components/CurrentSnapshot.astro";
import { current, currentEditions } from "@/data/current";
---

<BaseLayout
  title="Now | Nik Manuel"
  description="What Nik is building, reading, learning, listening to, and exploring in November 2026."
>
  <PageIntro
    eyebrow={`Now · ${current.period}`}
    title="What has my attention."
    description="The work, books, music, and questions filling my days at the moment."
    marker={`Updated ${current.updated}`}
  />
  <CurrentSnapshot edition={current} />
  <nav class="edition-archive page-pad" aria-label="Earlier snapshots">
    <p class="label">Earlier snapshots</p>{
      currentEditions.slice(1).map((edition) => (
        <a class="text-link" href={`/current/${edition.slug}/`}>
          {edition.period} →
        </a>
      ))
    }
  </nav>
</BaseLayout>
<style>
  .edition-archive {
    padding-block: 2rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    gap: 1rem 2rem;
    align-items: center;
    flex-wrap: wrap;
  }
</style>
