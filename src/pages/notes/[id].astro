---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/content";
import PersonalMark from "@/components/PersonalMark.astro";

export const getStaticPaths = (async () => {
  const notes = await getCollection(
    "notes",
    ({ data }) => data.status === "published",
  );
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout
  title={note.data.title + " | Nik Manuel"}
  description={note.data.description}
  type="article"
  noindex
  canonicalPath={"/essays/" + note.id + "/"}
>
  <article>
    <header class="note-hero page-pad">
      <img
        class="note-hero-graphic"
        src="/assets/brand/diagrams/topographic-registration-01.webp"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        fetchpriority="low"
      />
      <div class="note-meta">
        <p class="label note-meta-label">
          <PersonalMark variant="fish" size="1.15rem" />
          <span>{note.data.category}</span>
        </p>
        <p class="label label-muted">
          {formatDate(note.data.published)} / {note.data.readingMinutes} min read
        </p>
      </div>
      <h1 class="page-title">{note.data.title}</h1>
      <p class="note-description">{note.data.description}</p>
    </header>
    <div class="note-body prose">
      <Content />
    </div>
  </article>
  <nav class="note-next page-pad" aria-label="Continue exploring">
    <a class="text-link" href="/essays/">← All essays</a>
    {
      note.data.relatedPrinciples.length > 0 && (
        <a
          class="text-link"
          href={"/principles/#" + note.data.relatedPrinciples[0]}
        >
          Related principle&nbsp;→
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .note-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .note-hero-graphic {
    position: absolute;
    z-index: 0;
    top: 18%;
    right: -10%;
    width: min(58rem, 64vw);
    max-width: none;
    opacity: 0.075;
    pointer-events: none;
    user-select: none;
  }

  .note-meta {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .note-meta-label {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
  }

  .note-hero h1 {
    position: relative;
    z-index: 1;
    max-width: 16ch;
  }

  .note-description {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0 auto;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    line-height: 1.4;
  }

  .note-body {
    padding: var(--section-space) var(--page-pad);
  }

  .note-next {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--hairline-strong);
    padding-block: 2rem;
  }

  @media (max-width: 560px) {
    .note-hero {
      padding-block: 2.5rem;
    }

    .note-hero h1 {
      max-width: 23ch;
    }

    .note-description {
      margin-top: 1.5rem;
    }

    .note-meta {
      gap: 0.75rem;
      margin-bottom: 1.75rem;
    }

    .note-hero-graphic {
      top: 38%;
      right: -7rem;
      width: 30rem;
      opacity: 0.05;
    }

    .note-meta,
    .note-next {
      align-items: start;
      flex-direction: column;
    }

    .note-next {
      gap: 0.75rem;
    }
  }
</style>
