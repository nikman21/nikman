---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, getPublicNotes } from "@/lib/content";

const notes = await getPublicNotes();
---

<BaseLayout
  title="Essays | Nik Manuel"
  description="Personal essays on software, attention, faith, history, and everyday life."
  noindex
  canonicalPath="/essays/"
>
  <PageIntro
    title="Writing"
    description="Essays on software, attention, faith, and everyday life."
    marker={`${notes.length} essays`}
    mark="fish"
    graphic="stamp"
  />

  <section class="notes-index" aria-label="Published notes">
    {
      notes.map((note, index) => (
        <a class="note-row" href={"/essays/" + note.id + "/"}>
          <div class="note-meta">
            <span>{String(index + 1).padStart(3, "0")}</span>
            <span>{note.data.category}</span>
          </div>
          <div>
            <h2>{note.data.title}</h2>
            <p>{note.data.description}</p>
          </div>
          <div class="note-date">
            <span>{formatDate(note.data.published)}</span>
            <span>{note.data.readingMinutes} min read</span>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .notes-index {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .note-row {
    display: grid;
    min-height: 12rem;
    grid-template-columns: 9rem minmax(0, 1fr) 7rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    padding: 2.5rem var(--page-pad);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .note-row:hover {
    background: var(--paper-light);
  }

  .note-meta,
  .note-date {
    display: grid;
    gap: 0.5rem;
    align-self: start;
    font-size: 0.875rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .note-date {
    text-align: right;
  }

  h2 {
    max-width: 30ch;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .note-row p {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    h2 {
      max-width: 30ch;
      font-size: clamp(1.9rem, 3.2vw, 3.2rem);
      line-height: 1.08;
    }

    .note-row {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    .note-meta {
      grid-column: 1;
    }

    .note-row > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .note-date {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 460px) {
    .note-row {
      padding-block: 2rem;
    }

    .note-date span:first-child {
      display: none;
    }
  }
</style>
