---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, getPublicNotes } from "@/lib/content";

const notes = await getPublicNotes();
---

<BaseLayout
  title="Essays | Nik Manuel"
  description="Personal essays on building, attention, faith, history, design, and the work of becoming."
  noindex
  canonicalPath="/essays/"
>
  <PageIntro
    eyebrow="Essays / Developed arguments"
    title="Writing to find the shape of an idea."
    description="Personal experiences, durable questions, and ideas developed far enough to leave the workshop."
    mark="fish"
    graphic="stamp"
  />

  <section class="notes-index" aria-label="Published notes">
    {
      notes.map((note, index) => (
        <a class="note-row" href={"/essays/" + note.id + "/"}>
          <div class="note-meta">
            <span>{String(index + 1).padStart(3, "0")}</span>
            <span>{note.data.category}</span>
          </div>
          <div>
            <h2>{note.data.title}</h2>
            <p>{note.data.description}</p>
          </div>
          <div class="note-date">
            <span>{formatDate(note.data.published)}</span>
            <span>{note.data.readingMinutes} min read</span>
          </div>
        </a>
      ))
    }
  </section>

  <aside class="notes-aside page-pad section">
    <p class="label">Publishing rule</p>
    <p>
      This URL remains as a compatibility path. Essays now live at their
      canonical public home.
    </p>
  </aside>
</BaseLayout>

<style>
  .notes-index {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .note-row {
    display: grid;
    min-height: 18rem;
    grid-template-columns: 10rem minmax(0, 1fr) 9rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    padding: 2.5rem var(--page-pad);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .note-row:hover {
    background: var(--paper-light);
  }

  .note-meta,
  .note-date {
    display: grid;
    gap: 0.5rem;
    align-self: start;
    font-size: 0.68rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .note-date {
    text-align: right;
  }

  h2 {
    max-width: 16ch;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .note-row p {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-muted);
  }

  .notes-aside {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .notes-aside p:last-child {
    max-width: 21ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  @media (max-width: 760px) {
    .note-row {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    .note-meta {
      grid-column: 1;
    }

    .note-row > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .note-date {
      grid-column: 2;
      grid-row: 1;
    }

    .notes-aside {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .note-row {
      padding-block: 2rem;
    }

    .note-date span:first-child {
      display: none;
    }
  }
</style>
