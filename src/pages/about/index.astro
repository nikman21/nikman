---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutMedia from "@/components/AboutMedia.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
import { aboutMedia, aboutProfile } from "@/data/about";
import { current } from "@/data/current";
import { videos } from "@/data/videos";
import {
  profilePageEntity,
  freshIndustriesEntity,
  inflateMateEntity,
  structuredDataGraph,
} from "@/lib/structured-data";

const structuredData = structuredDataGraph(
  Astro.site,
  profilePageEntity(Astro.site),
  freshIndustriesEntity(Astro.site),
  inflateMateEntity(Astro.site),
);
const featuredVideo = videos[0];
const rabbitHoles = [
  {
    title: "Infrastructure",
    detail:
      "Learning Go and Docker on my Linux server, and working on deployments through Hatch.",
  },
  {
    title: "Personal context",
    detail:
      "Osef, Nima, and deciding which notes and recordings an agent should be able to use.",
  },
  {
    title: "Animation",
    detail:
      "Making animation with AI and developing Bara so I can edit the artwork and motion myself.",
  },
  {
    title: "Hardware and manufacturing",
    detail:
      "3D printing and learning how a design makes its way into production.",
  },
];
---

<BaseLayout
  title="About Nikolas Manuel | Nik Manuel"
  description="I'm Nik, co-founder of Fresh Industries in New Braunfels, Texas. A bit about my work, wrestling, and life outside software."
  {structuredData}
>
  <header class="about-hero page-pad">
    <div class="hero-copy">
      <p class="label">About me</p>
      <h1>Hi, I’m Nik</h1>
      <p class="hero-intro">
        I’m {aboutProfile.age} and live in {aboutProfile.location}. Most days,
        I’m working on software or a creative project.
      </p>
      <p class="hero-intro">
        Outside of work, I’m into martial arts, reading, and getting outdoors.
      </p>
    </div>
    <div class="hero-media">
      <AboutMedia
        asset={aboutMedia.portrait}
        title="Portrait of Nik"
        detail="A personal photo will go here."
        format="portrait"
      />
    </div>
  </header>

  <nav class="about-index page-pad" aria-label="On this page">
    <a href="#story">Story</a>
    <a href="#wrestling">Wrestling</a>
    <a href="#building">Projects</a>
    <a href="#outside">Off-screen</a>
    <a href="#rabbit-holes">Interests</a>
    <a href="#connect">Contact</a>
  </nav>

  <section
    class="about-section page-pad story-layout"
    id="story"
    aria-labelledby="story-title"
  >
    <div class="section-intro">
      <h2 id="story-title">After college</h2>
      <dl class="education-note">
        <dt>Education</dt>
        <dd>{aboutProfile.university}</dd>
        <dd>{aboutProfile.degree}</dd>
        <dd class="muted">{aboutProfile.graduated}</dd>
      </dl>
    </div>
    <div class="about-copy">
      <p>
        InflateMate started after I graduated from ASU and couldn’t get a job in
        technology. I put that energy into a product of my own.
      </p>
      <p>
        Customer support is now as much a part of my work as code. Hearing where
        someone gets stuck makes me reconsider decisions I thought were
        finished.
      </p>
      <p>
        Lately I’ve been learning more about Linux servers, 3D printing, and
        animation. I like having something to try while I’m learning.
      </p>
    </div>
  </section>

  <section
    class="about-section page-pad"
    id="wrestling"
    aria-labelledby="wrestling-title"
  >
    <div class="section-heading-copy">
      <h2 id="wrestling-title">Wrestling and martial arts</h2>
      <div class="about-copy">
        <p>
          I was a state champion wrestler in high school. The discipline and
          persistence it took to get there carried into the rest of my life,
          from learning new things to building businesses and <a
            href="/principles/#find-the-positive">working through setbacks</a
          >.
        </p>
      </div>
    </div>
    <div class="wrestling-media">
      <AboutMedia
        asset={aboutMedia.wrestlingPhoto}
        title="Wrestling photo"
        detail="A photo from the mat, with its story."
      />
      <div class="wrestling-video">
        <AboutMedia
          asset={aboutMedia.wrestlingClip}
          title="Wrestling clip"
          detail="A short clip and a little context."
          kind="video"
        />
        <a
          class="text-link full-match-link"
          href="/media/nik-state-final-full.mp4"
          target="_blank"
          rel="noreferrer">Watch the full match (3:39)<ExternalLinkIcon /></a
        >
      </div>
    </div>
  </section>

  <section
    class="about-section page-pad building-layout"
    id="building"
    aria-labelledby="building-title"
  >
    <div class="section-intro">
      <h2 id="building-title">
        <a href="/work/fresh-industries/">Fresh Industries</a>
      </h2>
      <p>
        I co-founded Fresh Industries to work on software, creative media, and
        services. These are a few of the projects I’m spending time on.
      </p>
      <a class="text-link" href="/work/">All projects →</a>
    </div>
    <div class="work-notebook">
      <article>
        <h3><a href="/work/inflatemate/">InflateMate</a></h3>
        <p>
          Party-rental software for bookings, inventory, payments, and waivers.
          It has paying customers, so I get to hear where it helps and where it
          still needs work.
        </p>
      </article>
      <article id="hatch">
        <h3>Hatch</h3>
        <p>
          A self-hosted deployment platform. It’s how I’m getting deeper into
          infrastructure, alongside <a href="/work/fresh-infra/">Fresh Infra</a
          >, a shared toolkit for my applications.
        </p>
      </article>
      <article>
        <h3><a href="/work/bara/">Bara</a></h3>
        <p>
          A local creative studio for artwork and animation, with one editing
          engine shared by its interface and agent tools.
        </p>
      </article>
      <article>
        <h3><a href="/work/osef/">Osef</a> and Nima</h3>
        <p>
          Experiments with saving thoughts and giving agents useful context. I
          want to be able to return to the things I save, including the
          originals.
        </p>
      </article>
    </div>
  </section>

  <section
    class="about-section page-pad outside-layout"
    id="outside"
    aria-labelledby="curiosity"
  >
    <div class="section-intro">
      <h2 id="curiosity">Away from the desk</h2>
      <p>
        I read fiction alongside design and marketing books, work out, and spend
        time with history, faith, and philosophy. I’ve also been trying to spend
        more time outside without my phone.
      </p>
      <a class="text-link" href="/essays/a-run-without-technology/"
        >A run without technology →</a
      >
    </div>
    <div class="personal-notebook">
      <div class="reading-note">
        <h3>On my reading pile</h3>
        <ul>{current.reading.map((book) => <li>{book}</li>)}</ul>
      </div>
      <div class="listening-note">
        <h3>Usually playing</h3>
        <p>
          Smooth jazz while I work, or my old high school playlist. Mostly
          2016–2018 rap.
        </p>
      </div>
      <a class="text-link" href="/current/">November update →</a>
    </div>
  </section>

  <section
    class="about-section page-pad sharing-layout"
    id="sharing"
    aria-labelledby="sharing-title"
  >
    <div class="section-intro">
      <h2 id="sharing-title">Videos and writing</h2>
      <p>
        I make YouTube videos about what I’m learning, including walkthroughs of
        my projects and ways to use AI. Explaining something helps me understand
        it better. I hope it helps someone else try it, too.
      </p>
      <a class="text-link" href="/essays/">Essays →</a>
    </div>
    <VideoEmbed id={featuredVideo.id} title={featuredVideo.title} />
  </section>

  <section
    class="about-section page-pad rabbit-layout"
    id="rabbit-holes"
    aria-labelledby="rabbit-title"
  >
    <div class="section-intro">
      <h2 id="rabbit-title">Current interests</h2>
    </div>
    <div class="rabbit-list">
      {
        rabbitHoles.map((item) => (
          <article>
            <>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .hero-copy {
    max-width: 40rem;
  }
  h1 {
    margin: 1.5rem 0;
    font: 430 clamp(3.5rem, 6.5vw, 6.2rem)/1.02 var(--font-display);
    letter-spacing: -0.045em;
  }
  .hero-intro {
    font-size: 1.12rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .hero-media {
    width: 100%;
    max-width: 25rem;
    justify-self: end;
  }
  .about-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--hairline);
  }
  .about-index a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
  }
  .about-section {
    padding-block: clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 1rem;
  }
  .story-layout,
  .building-layout,
  .outside-layout,
  .sharing-layout,
  .rabbit-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  h2 {
    font: 450 clamp(2rem, 3.6vw, 3.2rem)/1.08 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }
  h3 {
    font: 500 clamp(1.5rem, 2.3vw, 2rem)/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .about-copy p,
  .section-intro > p {
    max-width: 44rem;
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.5rem;
  }
  .about-copy > :last-child {
    margin-bottom: 0;
  }
  .section-intro .label {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }
  .education-note {
    margin: 2rem 0 0;
    border-left: 2px solid var(--orange);
    padding-left: 1rem;
  }
  .education-note dt {
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .education-note dd {
    margin: 0.25rem 0;
    font-size: 0.95rem;
  }
  .muted {
    color: var(--ink-muted);
  }
  .section-heading-copy {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-bottom: 2rem;
  }
  .wrestling-media {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }
  .wrestling-video {
    min-width: 0;
  }
  .full-match-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .work-notebook article,
  .rabbit-list article {
    border-top: 1px solid var(--hairline);
    padding-block: 1.5rem;
  }
  .work-notebook article:first-child,
  .rabbit-list article:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .work-notebook article:last-child,
  .rabbit-list article:last-child {
    padding-bottom: 0;
  }
  .work-notebook p,
  .rabbit-list p {
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.65;
  }
  .personal-notebook {
    background: var(--paper-light);
    padding: 2rem;
    border-top: 2px solid var(--orange);
  }
  .reading-note ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-note li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.98rem;
  }
  .listening-note {
    margin-top: 2rem;
  }
  .listening-note p {
    color: var(--ink-muted);
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .sharing-layout {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }
  .rabbit-list h3 {
    font-size: 1.65rem;
  }
  .text-link {
    font-size: 1.05rem;
  }
  @media (max-width: 900px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
    .story-layout,
    .building-layout,
    .outside-layout,
    .sharing-layout,
    .rabbit-layout,
    .section-heading-copy {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 2rem;
    }
  }
  @media (max-width: 680px) {
    .about-hero,
    .story-layout,
    .building-layout,
    .outside-layout,
    .sharing-layout,
    .rabbit-layout,
    .section-heading-copy,
    .wrestling-media {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 24rem;
      justify-self: start;
    }
    h1 {
      font-size: clamp(3.5rem, 12vw, 4.5rem);
    }
    .about-index {
      column-gap: 1.5rem;
    }
    .education-note {
      margin-top: 1.5rem;
    }
    .personal-notebook {
      padding: 1.5rem;
    }
  }
</style>
