---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutMedia from "@/components/AboutMedia.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import { aboutMedia, aboutProfile } from "@/data/about";
import { current } from "@/data/current";
import { videos } from "@/data/videos";
import { siteConfig } from "@/config";
import {
  profilePageEntity,
  freshIndustriesEntity,
  inflateMateEntity,
  structuredDataGraph,
} from "@/lib/structured-data";

const structuredData = structuredDataGraph(
  Astro.site,
  profilePageEntity(Astro.site),
  freshIndustriesEntity(Astro.site),
  inflateMateEntity(Astro.site),
);
const featuredVideo = videos[0];
const rabbitHoles = [
  {
    title: "What happens after I hit deploy?",
    detail:
      "Hatch, my Linux server, Go, Docker, and learning what it takes to keep software running.",
  },
  {
    title: "What should an agent remember?",
    detail:
      "Osef, Nima, personal context, and keeping original material separate from an agent’s interpretation.",
  },
  {
    title: "Can I make the tools and the story?",
    detail:
      "Bara, animation with AI, and getting more control over the things I want to create.",
  },
  {
    title: "How does an idea become a physical thing?",
    detail:
      "Hardware, 3D printing, manufacturing, and the steps between a design and something you can hold.",
  },
];
---

<BaseLayout
  title="About Nikolas Manuel | Nik Manuel"
  description="I'm Nik, a builder and Fresh Industries co-founder in New Braunfels, Texas. My story includes wrestling, ASU, software, creative experiments, and a lot of curiosity."
  {structuredData}
>
  <header class="about-hero page-pad">
    <div class="hero-copy">
      <p class="label">About me</p>
      <h1>Hi, I’m Nik</h1>
      <p class="name-line">{aboutProfile.fullName}, but I go by Nik.</p>
      <p class="hero-intro">
        I’m {aboutProfile.age}, based in {aboutProfile.location}, and usually in
        the middle of building something or figuring out how it works.
      </p>
      <p class="hero-intro">
        Software, businesses, creative tools, martial arts, and a growing pile
        of books. I like having a few different things to be curious about.
      </p>
      <p class="hero-note">
        Currently building through <a href="/work/fresh-industries/"
          >Fresh Industries</a
        >.
      </p>
    </div>
    <div class="hero-media">
      <AboutMedia
        asset={aboutMedia.portrait}
        title="Portrait of Nik"
        detail="A personal photo will go here."
        format="portrait"
      />
    </div>
  </header>

  <nav class="about-index page-pad" aria-label="On this page">
    <a href="#story">My story</a>
    <a href="#wrestling">Wrestling</a>
    <a href="#building">What I’m building</a>
    <a href="#outside">Outside the work</a>
    <a href="#rabbit-holes">Current rabbit holes</a>
    <a href="#connect">Say hello</a>
  </nav>

  <section
    class="about-section page-pad story-layout"
    id="story"
    aria-labelledby="story-title"
  >
    <div class="section-intro">
      <h2 id="story-title">A little of my story</h2>
      <dl class="education-note">
        <dt>Education</dt>
        <dd>{aboutProfile.university}</dd>
        <dd>{aboutProfile.degree}</dd>
        <dd class="muted">{aboutProfile.graduated}</dd>
      </dl>
    </div>
    <div class="about-copy">
      <p>
        After graduating from ASU, I wanted to work in technology. When I
        couldn’t get a job in it, I started creating work of my own. Building
        InflateMate gave that frustration somewhere to go.
      </p>
      <p>
        Since then, building has meant more than writing code. It has meant
        listening to customers, trying to explain an idea clearly, learning
        design, and figuring out what to do when something goes wrong.
      </p>
      <p>
        I like jumping into subjects I don’t understand yet. A web app, a
        server, a 3D printer, or an animation workflow can all pull me in. I
        want to understand how something works well enough to make something
        with it. I’m learning as I go, making mistakes, and getting more
        comfortable sharing the process.
      </p>
    </div>
  </section>

  <section
    class="about-section page-pad"
    id="wrestling"
    aria-labelledby="wrestling-title"
  >
    <div class="section-heading-copy">
      <h2 id="wrestling-title">Wrestling and martial arts</h2>
      <div class="about-copy">
        <p>
          I was a state champion wrestler in high school. The discipline and
          persistence it took to get there carried into the rest of my life,
          from learning new things to building businesses and <a
            href="/principles/#find-the-positive">working through setbacks</a
          >.
        </p>
      </div>
    </div>
    <div class="wrestling-media">
      <AboutMedia
        asset={aboutMedia.wrestlingPhoto}
        title="Wrestling photo"
        detail="A photo from the mat, with its story."
      />
      <div class="wrestling-video">
        <AboutMedia
          asset={aboutMedia.wrestlingClip}
          title="Wrestling clip"
          detail="A short clip and a little context."
          kind="video"
        />
        <a
          class="text-link full-match-link"
          href="/media/nik-state-final-full.mp4"
          target="_blank"
          rel="noreferrer">Watch the full match (3:39) ↗</a
        >
      </div>
    </div>
  </section>

  <section
    class="about-section page-pad building-layout"
    id="building"
    aria-labelledby="building-title"
  >
    <div class="section-intro">
      <h2 id="building-title">Building with Fresh Industries</h2>
      <p>
        I co-founded <a href="/work/fresh-industries/">Fresh Industries</a>,
        where we’re developing software products, creative tools, and services.
        It’s the broader home for the businesses and experiments we’re building.
      </p>
      <a class="text-link" href="/work/">Explore the projects →</a>
    </div>
    <div class="work-notebook">
      <article>
        <h3><a href="/work/inflatemate/">InflateMate</a></h3>
        <p>
          Software for party-rental businesses, with real paying customers.
          Working on bookings, inventory, payments, and waivers keeps teaching
          me how much the small details matter to the person using them.
        </p>
      </article>
      <article id="hatch">
        <h3>Hatch</h3>
        <p>
          My self-hosted deployment and infrastructure platform. I’m learning
          infrastructure engineering by actually building it. Alongside that,
          <a href="/work/fresh-infra/">Fresh Infra</a> is the shared toolkit I’m developing
          for my applications.
        </p>
      </article>
      <article>
        <h3><a href="/work/bara/">Bara</a></h3>
        <p>
          An experimental, local-first creative studio for design and media
          workflows. It brings together two things I enjoy: making tools and
          using them to create artwork, animation, and stories.
        </p>
      </article>
      <article>
        <h3><a href="/work/osef/">Osef</a> and Nima</h3>
        <p>
          Experiments in personal context, knowledge, and agentic workspaces.
          I’m exploring how the things we capture and learn can become useful
          context for the tools and agents we work with.
        </p>
      </article>
    </div>
  </section>

  <section
    class="about-section page-pad outside-layout"
    id="outside"
    aria-labelledby="curiosity"
  >
    <div class="section-intro">
      <h2 id="curiosity">There’s more around the keyboard</h2>
      <p>
        I read fiction alongside design and marketing books, work out, and spend
        time with history, faith, and philosophy. Sometimes getting outside
        without my phone is the most useful thing I can do with a morning.
      </p>
      <a class="text-link" href="/essays/a-run-without-technology/"
        >A run without technology →</a
      >
    </div>
    <div class="personal-notebook">
      <div class="reading-note">
        <h3>On my reading pile</h3>
        <ul>{current.reading.map((book) => <li>{book}</li>)}</ul>
      </div>
      <div class="listening-note">
        <h3>Usually playing</h3>
        <p>
          Smooth jazz while I work, or my old high school playlist. Mostly
          2016–2018 rap. A different kind of concentration music.
        </p>
      </div>
      <a class="text-link" href="/current/">The full Now update →</a>
    </div>
  </section>

  <section
    class="about-section page-pad sharing-layout"
    id="sharing"
    aria-labelledby="sharing-title"
  >
    <div class="section-intro">
      <h2 id="sharing-title">Sharing what I’m learning</h2>
      <p>
        I recently started making YouTube videos to document what I’m learning
        and help everyday people get better at using AI. A lot of the useful
        things happening in technology are still unfamiliar outside of tech. I
        want to help make them easier to understand and try.
      </p>
      <p>
        My mission is to inspire curiosity, creativity, and the confidence to
        build things. I want to understand something, create from that
        knowledge, and share the process.
      </p>
      <a class="text-link" href="/essays/">Read my writing →</a>
    </div>
    <VideoEmbed id={featuredVideo.id} title={featuredVideo.title} />
  </section>

  <section
    class="about-section page-pad rabbit-layout"
    id="rabbit-holes"
    aria-labelledby="rabbit-title"
  >
    <div class="section-intro">
      <p class="label">Lately</p>
      <h2 id="rabbit-title">Current rabbit holes</h2>
      <p>The questions I’m poking at right now.</p>
    </div>
    <div class="rabbit-list">
      {
        rabbitHoles.map((item) => (
          <article>
            <>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="about-section page-pad connect-layout"
    id="connect"
    aria-labelledby="connect-title"
  >
    <div>
      <h2 id="connect-title">Say hello</h2>
      <p>
        If you’re building something, following a similar rabbit hole, or just
        want to talk, I’d enjoy hearing from you.
        <a
          href="https://www.linkedin.com/in/nikolas-manuel-dev/"
          target="_blank"
          rel="noreferrer">You can reach me on LinkedIn</a
        >.
      </p>
    </div>
    <div class="connect-links">
      <a href="/essays/">Writing →</a>
      {
        siteConfig.socials.map((social) => (
          <a href={social.href} target="_blank" rel="noreferrer">
            {social.label} ↗
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .hero-copy {
    max-width: 40rem;
  }
  h1 {
    margin: 1.5rem 0;
    font: 430 clamp(3.5rem, 6.5vw, 6.2rem)/1.02 var(--font-display);
    letter-spacing: -0.045em;
  }
  .name-line {
    font: 450 clamp(1.5rem, 2.3vw, 2rem)/1.3 var(--font-display);
    margin-bottom: 1.5rem;
  }
  .hero-intro {
    font-size: 1.12rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .hero-note {
    margin: 2rem 0 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
  .hero-media {
    width: 100%;
    max-width: 25rem;
    justify-self: end;
  }
  .about-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--hairline);
  }
  .about-index a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
  }
  .about-section {
    padding-block: clamp(3rem, 5vw, 4rem);
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: 1rem;
  }
  .story-layout,
  .building-layout,
  .outside-layout,
  .sharing-layout,
  .rabbit-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  h2 {
    font: 450 clamp(2rem, 3.6vw, 3.2rem)/1.08 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem;
  }
  h3 {
    font: 500 clamp(1.5rem, 2.3vw, 2rem)/1.15 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .about-copy p,
  .section-intro > p,
  .connect-layout p {
    max-width: 44rem;
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.5rem;
  }
  .about-copy > :last-child {
    margin-bottom: 0;
  }
  .section-intro .label {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }
  .education-note {
    margin: 2rem 0 0;
    border-left: 2px solid var(--orange);
    padding-left: 1rem;
  }
  .education-note dt {
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .education-note dd {
    margin: 0.25rem 0;
    font-size: 0.95rem;
  }
  .muted {
    color: var(--ink-muted);
  }
  .section-heading-copy {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-bottom: 2rem;
  }
  .wrestling-media {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }
  .wrestling-video {
    min-width: 0;
  }
  .full-match-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .work-notebook article,
  .rabbit-list article {
    border-top: 1px solid var(--hairline);
    padding-block: 1.5rem;
  }
  .work-notebook article:first-child,
  .rabbit-list article:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .work-notebook article:last-child,
  .rabbit-list article:last-child {
    padding-bottom: 0;
  }
  .work-notebook p,
  .rabbit-list p {
    color: var(--ink-muted);
    margin: 0;
    line-height: 1.65;
  }
  .personal-notebook {
    background: var(--paper-light);
    padding: 2rem;
    border-top: 2px solid var(--orange);
  }
  .reading-note ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reading-note li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--hairline);
    font-size: 0.98rem;
  }
  .listening-note {
    margin-top: 2rem;
  }
  .listening-note p {
    color: var(--ink-muted);
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .sharing-layout {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }
  .rabbit-list h3 {
    font-size: 1.65rem;
  }
  .connect-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.45fr);
    gap: 3rem;
    border-bottom: 0;
  }
  .connect-layout p {
    max-width: 36rem;
    margin-bottom: 0;
  }
  .connect-links {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }
  .connect-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    width: fit-content;
  }
  .text-link {
    font-size: 1.05rem;
  }
  @media (max-width: 900px) {
    .about-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
    .story-layout,
    .building-layout,
    .outside-layout,
    .sharing-layout,
    .rabbit-layout,
    .section-heading-copy {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 2rem;
    }
  }
  @media (max-width: 680px) {
    .about-hero,
    .story-layout,
    .building-layout,
    .outside-layout,
    .sharing-layout,
    .rabbit-layout,
    .section-heading-copy,
    .wrestling-media,
    .connect-layout {
      grid-template-columns: 1fr;
    }
    .hero-media {
      max-width: 24rem;
      justify-self: start;
    }
    h1 {
      font-size: clamp(3.5rem, 12vw, 4.5rem);
    }
    .hero-note {
      margin-top: 1.5rem;
    }
    .about-index {
      column-gap: 1.5rem;
    }
    .education-note {
      margin-top: 1.5rem;
    }
    .personal-notebook {
      padding: 1.5rem;
    }
    .connect-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1.5rem;
    }
    .connect-layout {
      gap: 1.5rem;
    }
  }
</style>
