---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PersonalMark from "@/components/PersonalMark.astro";
import {
  freshIndustriesEntity,
  inflateMateEntity,
  structuredDataGraph,
} from "@/lib/structured-data";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects", ({ data }) => data.public);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const structuredData = structuredDataGraph(
  Astro.site,
  project.id === "fresh-industries"
    ? freshIndustriesEntity(Astro.site)
    : freshIndustriesEntity(Astro.site),
  ...(project.id === "inflatemate" ? [inflateMateEntity(Astro.site)] : []),
);
const projectIdentity =
  project.id === "fresh-industries"
    ? {
        mark: "orange" as const,
        image: "/assets/brand/landscapes/satellite-grove-01-plate.webp",
        imageId: "IMG / SG-01",
        imageLabel: "Cultivation system / Field plate",
        alt: "Processed orange grove beneath a saturated blue sky",
      }
    : {
        mark: "king" as const,
        image: "/assets/brand/landscapes/field-station-dawn-01-plate.webp",
        imageId: "IMG / FS-01",
        imageLabel: "Working system / Field plate",
        alt: "Retro-processed field station in an orange landscape",
      };
---

<BaseLayout
  title={project.data.title + " | Work by Nik Manuel"}
  description={project.data.description}
  type="article"
  {structuredData}
>
  <article>
    <header class="project-hero page-pad">
      <div class="project-meta">
        <p class="label project-meta-label">
          <PersonalMark variant={projectIdentity.mark} size="1.15rem" />
          <span>{project.data.eyebrow}</span>
        </p>
        <p class="label label-muted">{project.data.status}</p>
      </div>
      <h1 class="page-title">{project.data.title}</h1>
      <div class="project-evidence">
        <figure class="project-plate">
          <img
            src={projectIdentity.image}
            alt={projectIdentity.alt}
            width="768"
            height="512"
            loading="eager"
            decoding="async"
            fetchpriority="low"
          />
          <figcaption>
            <span>{projectIdentity.imageId}</span>
            <span>{projectIdentity.imageLabel}</span>
          </figcaption>
        </figure>
        <div class="project-facts">
          <div>
            <p class="label label-muted">For</p>
            <p>{project.data.audience}</p>
          </div>
          <div>
            <p class="label label-muted">Role</p>
            <p>{project.data.role}</p>
          </div>
        </div>
      </div>
    </header>
    <div class="project-summary page-pad">
      <p>{project.data.description}</p>
    </div>
    <div class="prose project-body">
      <Content />
    </div>
  </article>
  <nav class="project-next page-pad" aria-label="Continue exploring">
    <a class="text-link" href="/work/">← All work</a>
    <a class="text-link" href="/essays/">Read the essays&nbsp;→</a>
  </nav>
</BaseLayout>

<style>
  .project-hero {
    padding-block: clamp(4rem, 10vw, 9rem);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(4rem, 9vw, 9rem);
  }

  .project-hero h1 {
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .project-meta-label {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
  }

  .project-evidence {
    display: grid;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(24rem, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .project-plate {
    margin: 0;
    border-top: 1px solid var(--orange);
    padding-top: 0.55rem;
  }

  .project-plate img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .project-plate figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.65rem;
    color: var(--ink-muted);
    font-size: 0.62rem;
    font-weight: 590;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .project-facts > div {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1rem;
  }

  .project-facts p:last-child {
    margin-block: 0.65rem 0;
  }

  .project-summary {
    padding-block: clamp(3rem, 6vw, 6rem);
    background: var(--ink);
    color: var(--paper-light);
  }

  .project-summary p {
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .project-body {
    padding-block: var(--section-space);
    padding-inline: var(--page-pad);
  }

  .project-next {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--hairline-strong);
    padding-block: 2rem;
  }

  @media (max-width: 560px) {
    .project-evidence {
      grid-template-columns: 1fr;
    }

    .project-facts {
      grid-template-columns: 1fr;
    }

    .project-next {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
