---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getPublicProjects } from "@/lib/content";
const projects = (await getPublicProjects()).filter(
  (project) => project.data.kind !== "company",
);
---

<BaseLayout
  title="Projects | Nik Manuel"
  description="Software, creative tools, and experiments by Nik Manuel, with project details, artifacts, and links."
>
  <PageIntro
    title="Projects"
    description="Tools for businesses, creative work, and the ideas I want to keep. A few are products. Others are still experiments."
  />
  <section class="project-grid page-pad section" aria-label="Projects">
    {projects.map((project) => <ProjectCard {project} />)}
  </section>
  <aside class="company-note page-pad">
    <p>
      These projects are part of <a href="/work/fresh-industries/"
        >Fresh Industries</a
      >, the company I co-founded for software, creative tools, and services.
    </p><a class="text-link" href="/current/">What I’m working on now →</a>
  </aside>
</BaseLayout>
<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 2.5rem;
  }
  .company-note {
    border-top: 1px solid var(--hairline);
    padding-block: 2rem;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    align-items: center;
  }
  .company-note p {
    max-width: 40rem;
    margin: 0;
    color: var(--ink-muted);
  }
  .company-note > .text-link {
    flex: none;
  }
  @media (max-width: 680px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .company-note {
      flex-direction: column;
      align-items: start;
      gap: 1rem;
    }
  }
</style>
