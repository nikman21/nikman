---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, getPublicNotes } from "@/lib/content";

const essays = await getPublicNotes();
const years = Array.from(
  new Set(essays.map((essay) => essay.data.published.getUTCFullYear())),
).sort((a, b) => b - a);
const topics = Array.from(
  new Set(essays.map((essay) => essay.data.category)),
).sort();
---

<BaseLayout
  title="Essays | Nik Manuel"
  description="Personal essays on building, attention, faith, history, design, and the work of becoming."
>
  <PageIntro
    eyebrow="Essays / Developed arguments"
    title="Writing to find the shape of an idea."
    description="Personal experiences, durable questions, and ideas developed far enough to leave the workshop."
    mark="fish"
    graphic="stamp"
  />

  <aside class="essay-register page-pad" aria-label="Essay archive summary">
    <p class="label">Archive register</p>
    <div>
      <p class="register-years">
        {
          years
            .map(
              (year) =>
                `${year} / ${essays.filter((essay) => essay.data.published.getUTCFullYear() === year).length} published`,
            )
            .join("  ")
        }
      </p>
      <p class="register-topics">{topics.join(" / ")}</p>
    </div>
  </aside>

  <section class="essays-index" aria-label="Published essays">
    {
      essays.map((essay, index) => (
        <a class="essay-row" href={"/essays/" + essay.id + "/"}>
          <div class="essay-meta">
            <span>{String(index + 1).padStart(3, "0")}</span>
            <span>{essay.data.category}</span>
          </div>
          <div>
            <h2>{essay.data.title}</h2>
            <p>{essay.data.description}</p>
          </div>
          <div class="essay-date">
            <span>{formatDate(essay.data.published)}</span>
            <span>{essay.data.readingMinutes} min read</span>
          </div>
        </a>
      ))
    }
  </section>

  <aside class="essays-aside page-pad section">
    <p class="label">Publishing rule</p>
    <p>
      A developed argument, a concrete experience, and a conclusion worth
      carrying forward.
    </p>
  </aside>
</BaseLayout>

<style>
  .essay-register {
    display: grid;
    grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--hairline-strong);
    background: var(--ink);
    color: var(--paper-light);
  }

  .essay-register > div {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .register-years,
  .register-topics {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .register-topics {
    max-width: 42rem;
    color: rgba(248, 244, 235, 0.65);
    text-align: right;
  }

  .essays-index {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .essay-row {
    display: grid;
    min-height: 18rem;
    grid-template-columns: 11rem minmax(0, 1fr) 9rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    padding: 2.5rem var(--page-pad);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .essay-row:hover {
    background: var(--paper-light);
  }

  .essay-meta,
  .essay-date {
    display: grid;
    gap: 0.5rem;
    align-self: start;
    font-size: 0.68rem;
    font-weight: 590;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .essay-date {
    text-align: right;
  }

  h2 {
    max-width: 17ch;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5.5rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .essay-row p {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-muted);
  }

  .essays-aside {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .essays-aside p:last-child {
    max-width: 21ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  @media (max-width: 760px) {
    .essay-register,
    .essay-register > div {
      grid-template-columns: 1fr;
      flex-direction: column;
      gap: 1rem;
    }

    .register-topics {
      text-align: left;
    }

    .essay-row {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    .essay-meta {
      grid-column: 1;
    }

    .essay-row > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .essay-date {
      grid-column: 2;
      grid-row: 1;
    }

    .essays-aside {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .essay-row {
      padding-block: 2rem;
    }

    .essay-date span:first-child {
      display: none;
    }
  }
</style>
