---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, getPublicNotes } from "@/lib/content";

const essays = await getPublicNotes();
---

<BaseLayout
  title="Essays | Nik Manuel"
  description="Personal essays on software, attention, faith, history, and everyday life."
>
  <PageIntro
    title="Writing"
    description="Essays on software, attention, faith, and everyday life."
    marker={`${essays.length} essays`}
    mark="fish"
    graphic="stamp"
  />

  <section class="essays-index" aria-label="Published essays">
    {
      essays.map((essay, index) => (
        <a class="essay-row" href={"/essays/" + essay.id + "/"}>
          <div class="essay-meta">
            <span>{String(index + 1).padStart(3, "0")}</span>
            <span>{essay.data.category}</span>
          </div>
          <div>
            <h2>{essay.data.title}</h2>
            <p>{essay.data.description}</p>
          </div>
          <div class="essay-date">
            <span>{formatDate(essay.data.published)}</span>
            <span>{essay.data.readingMinutes} min read</span>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .essays-index {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .essay-row {
    display: grid;
    min-height: 12rem;
    grid-template-columns: 9rem minmax(0, 1fr) 7rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    padding: 2.5rem var(--page-pad);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .essay-row:hover {
    background: var(--paper-light);
  }

  .essay-meta,
  .essay-date {
    display: grid;
    gap: 0.5rem;
    align-self: start;
    font-size: 0.875rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .essay-date {
    text-align: right;
  }

  h2 {
    max-width: 30ch;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .essay-row p {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-muted);
  }

  .essays-aside {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .essays-aside p:last-child {
    max-width: 21ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  @media (max-width: 760px) {
    h2 {
      line-height: 1.08;
    }

    .essay-row {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    .essay-meta {
      grid-column: 1;
    }

    .essay-row > div:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .essay-date {
      grid-column: 2;
      grid-row: 1;
    }

    .essays-aside {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 460px) {
    .essay-row {
      padding-block: 2rem;
    }

    .essay-date span:first-child {
      display: none;
    }
  }
</style>
