---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, getPublicGardenNotes } from "@/lib/content";

const notes = await getPublicGardenNotes();
---

<BaseLayout
  title="Garden | Nik Manuel"
  description="A curated digital garden of connected ideas about attention, trust, tradition, and interface craft."
>
  <PageIntro
    title="Garden"
    description="Notes on attention, trust, design, and other ideas still taking shape."
    mark="compass"
    graphic="orbital"
  />

  <aside class="maturity-guide" aria-label="Garden note maturity guide">
    <div>
      <span>01</span><strong>Seedling</strong><small
        >A question or early observation</small
      >
    </div>
    <div>
      <span>02</span><strong>Growing</strong><small
        >An idea gaining connections and evidence</small
      >
    </div>
    <div>
      <span>03</span><strong>Evergreen</strong><small
        >A developed note, open to revision</small
      >
    </div>
  </aside>

  <section class="garden-index" aria-label="Public garden notes">
    {
      notes.map((note, index) => (
        <a class="garden-row" href={"/garden/" + note.id + "/"}>
          <div class="garden-meta">
            <span>{String(index + 1).padStart(3, "0")}</span>
            <span>{note.data.maturity}</span>
          </div>
          <div class="garden-main">
            <p class="label">{note.data.topic}</p>
            <h2>{note.data.title}</h2>
            <p>{note.data.summary}</p>
          </div>
          <div class="garden-date">
            <span>Updated</span>
            <span>{formatDate(note.data.updated)}</span>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .maturity-guide {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--hairline-strong);
    background: var(--ink);
    color: var(--paper-light);
  }

  .maturity-guide > div {
    display: grid;
    min-height: 6rem;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.6rem 1rem;
    align-content: center;
    padding: 1.5rem var(--page-pad);
  }

  .maturity-guide > div + div {
    border-left: 1px solid rgba(248, 244, 235, 0.25);
  }

  .maturity-guide span,
  .maturity-guide small {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .maturity-guide span {
    color: var(--orange);
  }

  .maturity-guide strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 470;
  }

  .maturity-guide small {
    grid-column: 2;
    color: rgba(248, 244, 235, 0.68);
    line-height: 1.45;
  }

  .garden-index {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .garden-row {
    display: grid;
    min-height: 11rem;
    grid-template-columns: 8rem minmax(0, 1fr) 9rem;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    padding: 2.5rem var(--page-pad);
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  .garden-row:hover {
    background: var(--paper-light);
  }

  .garden-meta,
  .garden-date {
    display: grid;
    gap: 0.5rem;
    align-self: start;
    font-size: 0.875rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .garden-date {
    text-align: right;
  }

  .garden-main h2 {
    max-width: 18ch;
    margin-block: 1.4rem 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.2vw, 3.2rem);
    font-weight: 430;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .garden-main > p:last-child {
    max-width: 44rem;
    margin: 0;
    color: var(--ink-muted);
  }

  .garden-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .garden-note p:last-child {
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  @media (max-width: 720px) {
    .maturity-guide {
      grid-template-columns: 1fr;
    }

    .maturity-guide > div {
      min-height: 0;
    }

    .maturity-guide > div + div {
      border-top: 1px solid rgba(248, 244, 235, 0.25);
      border-left: 0;
    }

    .garden-row {
      grid-template-columns: 1fr auto;
      gap: 1.5rem;
    }

    .garden-main {
      grid-column: 1 / -1;
    }

    .garden-note {
      grid-template-columns: 1fr;
    }
  }
</style>
