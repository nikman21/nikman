---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PersonalMark from "@/components/PersonalMark.astro";
import { formatDate } from "@/lib/content";
import {
  gardenArticleEntity,
  structuredDataGraph,
} from "@/lib/structured-data";

export const getStaticPaths = (async () => {
  const notes = await getCollection(
    "garden",
    ({ data }) => data.status === "published",
  );
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);
const structuredData = structuredDataGraph(
  Astro.site,
  gardenArticleEntity(Astro.site, {
    path: "/garden/" + note.id + "/",
    headline: note.data.title,
    description: note.data.summary,
    created: note.data.created,
    updated: note.data.updated,
    topic: note.data.topic,
  }),
);
---

<BaseLayout
  title={note.data.title + " | Garden by Nik Manuel"}
  description={note.data.summary}
  type="article"
  {structuredData}
>
  <article>
    <header class="garden-hero page-pad">
      <img
        class="garden-graphic"
        src="/assets/brand/diagrams/orbital-citrus-system-01.webp"
        alt=""
        aria-hidden="true"
        loading="eager"
        decoding="async"
        fetchpriority="low"
      />
      <div class="garden-meta">
        <p class="label garden-meta-label">
          <PersonalMark variant="compass" size="1.15rem" />
          <span>{note.data.topic}</span>
        </p>
        <p class="label label-muted">
          <a href="/about/" rel="author">Nik Manuel</a> / {note.data.maturity} / Updated
          {formatDate(note.data.updated)}
        </p>
      </div>
      <h1 class="page-title">{note.data.title}</h1>
      <p class="garden-description">{note.data.summary}</p>
    </header>
    <div class="garden-body prose">
      <Content />
    </div>
  </article>
  <nav class="garden-next page-pad" aria-label="Continue exploring">
    <a class="text-link" href="/garden/">← All garden notes</a>
    <a class="text-link" href="/essays/">Read the essays&nbsp;→</a>
  </nav>
</BaseLayout>

<style>
  .garden-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .garden-graphic {
    position: absolute;
    z-index: 0;
    top: 6%;
    right: -8%;
    width: min(42rem, 48vw);
    opacity: 0.07;
    pointer-events: none;
  }

  .garden-meta,
  .garden-hero h1,
  .garden-description {
    position: relative;
    z-index: 1;
  }

  .garden-meta {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  .garden-meta-label {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
  }

  .garden-meta a {
    color: inherit;
    text-decoration: none;
  }

  .garden-description {
    max-width: 42rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0 auto;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.85rem);
    line-height: 1.4;
  }

  .garden-body {
    padding: var(--section-space) var(--page-pad);
  }

  .garden-next {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--hairline-strong);
    padding-block: 2rem;
  }

  @media (max-width: 560px) {
    .garden-graphic {
      right: -7rem;
      width: 28rem;
      opacity: 0.045;
    }

    .garden-meta,
    .garden-next {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
