---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getAcceptedPrinciples } from "@/lib/content";

const entries = await getAcceptedPrinciples();
const principles = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const relatedEssayTitles: Record<string, string> = {
  "why-i-built-a-personal-encyclopedia":
    "Why I Built a Personal Encyclopedia Instead of a Productivity System",
  "playing-long-term-games":
    "Playing Long-Term Games When You Are Naturally Impatient",
  "a-run-without-technology": "A Run Without Technology",
};
---

<BaseLayout
  title="Principles | Nik Manuel"
  description="A small personal canon of ideas Nik has consciously chosen to practice, test, and return to."
>
  <PageIntro
    eyebrow="Stone / Accepted principles"
    title="Principles"
    description="These are not declarations that I have life figured out. They are ideas I have consciously chosen to practice, test, and return to."
    mark="cross"
    graphic="topographic"
  />

  <section class="principles-list">
    {
      principles.map(({ entry, Content }) => (
        <article id={entry.id} class="principle">
          <div class="principle-number">
            <p class="label">Principle</p>
            <p>0{entry.data.number}</p>
          </div>
          <div class="principle-main">
            <h2>{entry.data.title}</h2>
            <p class="principle-summary">{entry.data.summary}</p>
            <blockquote>{entry.data.question}</blockquote>
            <div class="principle-body">
              <Content />
            </div>
            {entry.data.relatedNotes.length > 0 && (
              <div class="related-writing">
                <p class="label">Related public writing</p>
                {entry.data.relatedNotes.map((slug) => (
                  <a href={"/essays/" + slug + "/"}>
                    {relatedEssayTitles[slug] ?? "Read the related essay"}
                    &nbsp;→
                  </a>
                ))}
              </div>
            )}
          </div>
          <aside>
            <p class="label">Practice</p>
            <ul>
              {entry.data.practices.map((practice) => (
                <li>{practice}</li>
              ))}
            </ul>
            <p class="label why-label">Why I chose it</p>
            <p>{entry.data.whyChosen}</p>
          </aside>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .principles-list {
    border-bottom: 1px solid var(--hairline-strong);
  }

  .principle {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(2rem, 6vw, 6rem);
    border-bottom: 1px solid var(--hairline-strong);
    padding: clamp(4rem, 9vw, 8rem) var(--page-pad);
    scroll-margin-top: 2rem;
  }

  .principle-number p:last-child {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
  }

  .principle-main h2 {
    max-width: 12ch;
    margin-bottom: 2rem;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 7vw, 7rem);
    font-weight: 430;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .principle-summary {
    max-width: 44rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.1vw, 1.65rem);
    line-height: 1.45;
  }

  blockquote {
    margin: clamp(3rem, 7vw, 6rem) 0;
    border-left: 2px solid var(--orange);
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .principle-body {
    max-width: 42rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .related-writing {
    display: grid;
    gap: 0.8rem;
    margin-top: 3rem;
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1.25rem;
  }

  .related-writing a {
    width: fit-content;
    font-size: 0.82rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  aside {
    align-self: start;
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1.25rem;
  }

  aside ul {
    margin-block: 1.5rem 0;
    padding-left: 1.25rem;
  }

  aside li + li {
    margin-top: 0.75rem;
  }

  .why-label {
    margin-top: 3rem;
  }

  aside > p:last-child {
    color: var(--ink-muted);
  }

  @media (max-width: 960px) {
    .principle {
      grid-template-columns: 6rem 1fr;
    }

    aside {
      grid-column: 2;
    }
  }

  @media (max-width: 620px) {
    .principle {
      grid-template-columns: 1fr;
    }

    .principle-number {
      display: flex;
      gap: 1rem;
      align-items: baseline;
    }

    .principle-number p:last-child {
      margin: 0;
      font-size: 1.5rem;
    }

    aside {
      grid-column: 1;
    }
  }
</style>
