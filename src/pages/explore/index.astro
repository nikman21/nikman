---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import { getPublicGardenNotes, getPublicNotes } from "@/lib/content";
const [essays, garden] = await Promise.all([
  getPublicNotes(),
  getPublicGardenNotes(),
]);
const areas = [
  {
    title: "Build",
    href: "/work/",
    detail: "Software, creative tools, businesses, and interactive examples.",
  },
  {
    title: "Writing",
    href: "/essays/",
    detail:
      "Personal stories and ideas I have spent some time working through.",
  },
  {
    title: "Garden",
    href: "/garden/",
    detail:
      "Useful notes, questions, and connections that are still developing.",
  },
  {
    title: "Principles",
    href: "/principles/",
    detail: "A small set of ideas I have chosen to practice and return to.",
  },
  {
    title: "Commonplace",
    href: "/commonplace/",
    detail:
      "Other people’s words, with sources and a note about why I kept them.",
  },
  {
    title: "Now",
    href: "/current/",
    detail: "What I am building, reading, listening to, and exploring.",
  },
];
const topics = Array.from(
  new Set([
    ...essays.map((e) => e.data.category),
    ...garden.map((e) => e.data.topic),
  ]),
).sort();
const topicId = (topic: string) =>
  topic.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout
  title="Explore | Nik Manuel"
  description="Find a way into Nik's projects, writing, notes, principles, and current interests."
>
  <PageIntro
    eyebrow="Explore"
    title="Explore"
    description="A few ways into this place, depending on what caught your attention."
  />
  <nav class="area-grid page-pad section" aria-label="Explore the site">
    {
      areas.map((area) => (
        <a href={area.href}>
          <>
            <strong>
              {area.title}
              <span aria-hidden="true">→</span>
            </strong>
            <p>{area.detail}</p>
          </>
        </a>
      ))
    }
  </nav>
  <section class="topics page-pad section" aria-labelledby="topics-title">
    <p class="label">By interest</p><h2 id="topics-title">
      Browse by interest
    </h2><nav class="topic-links" aria-label="Topics">
      {topics.map((topic) => <a href={`#${topicId(topic)}`}>{topic}</a>)}
    </nav><div class="topic-groups">
      {
        topics.map((topic) => (
          <section id={topicId(topic)}>
            <>
              <h3>{topic}</h3>
              <ul>
                {essays
                  .filter((e) => e.data.category === topic)
                  .map((essay) => (
                    <li>
                      <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
                      <span>Essay</span>
                    </li>
                  ))}
                {garden
                  .filter((n) => n.data.topic === topic)
                  .map((note) => (
                    <li>
                      <a href={`/garden/${note.id}/`}>{note.data.title}</a>
                      <span>{note.data.maturity} note</span>
                    </li>
                  ))}
              </ul>
            </>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }
  .area-grid > a {
    display: block;
    padding: 1.5rem 0;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
  }
  .area-grid strong {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 480 2rem/1.1 var(--font-display);
  }
  .area-grid > a:hover strong {
    text-decoration: underline;
    text-decoration-color: var(--vermilion);
  }
  .area-grid p {
    color: var(--ink-muted);
    max-width: 34rem;
    margin: 0.8rem 0 0;
  }
  .topics {
    border-top: 1px solid var(--hairline);
  }
  .topics h2 {
    font: 470 clamp(2rem, 3.5vw, 3.3rem)/1.05 var(--font-display);
    margin: 1rem 0 1.5rem;
    letter-spacing: -0.03em;
  }
  .topic-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 2rem;
  }
  .topic-links a {
    min-height: 44px;
    align-content: center;
    font-size: 0.9rem;
  }
  .topic-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
  }
  .topic-groups section {
    border-top: 1px solid var(--hairline);
    padding-top: 1.5rem;
    scroll-margin-top: 2rem;
  }
  .topic-groups h3 {
    font: 500 1.5rem/1.2 var(--font-display);
  }
  .topic-groups ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .topic-groups li {
    display: grid;
    gap: 0.3rem;
  }
  .topic-groups li a {
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .topic-groups li span {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  @media (max-width: 650px) {
    .area-grid,
    .topic-groups {
      grid-template-columns: 1fr;
    }
  }
</style>
