---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PersonalMark from "@/components/PersonalMark.astro";
---

<BaseLayout
  title="Page not found | Nik Manuel"
  description="This page could not be found."
  noindex
  canonicalPath="/404.html"
>
  <section class="not-found page-pad">
    <img
      class="not-found-graphic"
      src="/assets/brand/editorial-framing/calibration-corner-01.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      fetchpriority="low"
    />
    <p class="label not-found-label">
      <PersonalMark variant="compass" size="1.15rem" />
      <span>404</span>
    </p>
    <h1 class="page-title">I can’t find that page.</h1>
    <p>It may have moved. Try the homepage or browse the site index.</p>
    <a class="text-link" href="/">Back home&nbsp;→</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    padding-block: clamp(5rem, 14vw, 12rem);
  }

  .not-found-graphic {
    position: absolute;
    z-index: 0;
    right: -8rem;
    bottom: -4rem;
    width: min(42rem, 48vw);
    max-width: none;
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }

  .not-found > :not(.not-found-graphic) {
    position: relative;
    z-index: 1;
  }

  .not-found-label {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
  }

  h1 {
    max-width: 13ch;
    margin-block: clamp(4rem, 8vw, 8rem) 2rem;
  }

  .not-found > p:not(.label) {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .not-found .text-link {
    margin-top: 1rem;
  }

  @media (max-width: 600px) {
    .not-found-graphic {
      right: -7rem;
      width: 27rem;
      opacity: 0.06;
    }
  }
</style>
