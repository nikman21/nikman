---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "@/assets/space-field-orange-tree-01.png";
import ProjectCard from "@/components/ProjectCard.astro";
import VideoEmbed from "@/components/VideoEmbed.astro";
import {
  getPublicProjects,
  getPublicNotes,
  getPublicGardenNotes,
} from "@/lib/content";
import { current } from "@/data/current";
import { videos } from "@/data/videos";
import {
  freshIndustriesEntity,
  inflateMateEntity,
  structuredDataGraph,
} from "@/lib/structured-data";
const [projects, essays, notes] = await Promise.all([
  getPublicProjects(),
  getPublicNotes(),
  getPublicGardenNotes(),
]);
const featured = projects
  .filter((project) => project.data.featured)
  .slice(0, 4);
const structuredData = structuredDataGraph(
  Astro.site,
  freshIndustriesEntity(Astro.site),
  inflateMateEntity(Astro.site),
);
---

<BaseLayout {structuredData}>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="label">Nik Manuel · Building & exploring</p><h1>
        I build things.<br />And follow the questions.
      </h1><p class="hero-intro">
        Software, creative tools, businesses, and the occasional rabbit hole.
        This is where I share what I make and what I’m figuring out along the
        way.
      </p><div class="hero-links">
        <a class="text-link" href="/work/">See what I’m building →</a><a
          class="text-link"
          href="/essays/">Read my writing →</a
        >
      </div><p class="hero-aside">
        Currently building through <a href="/work/fresh-industries/"
          >Fresh Industries</a
        >.
      </p>
    </div>
    <figure class="hero-image">
      <Image
        src={heroImage}
        alt="An orange tree on a red plain under a cobalt sky and moon"
        width={900}
        format="webp"
        quality={85}
        fetchpriority="high"
        loading="eager"
      /><figcaption>A little room to explore.</figcaption>
    </figure>
  </section>
  <section class="home-builds page-pad section" aria-labelledby="builds-title">
    <div class="section-heading">
      <div>
        <h2 id="builds-title">What I’m building</h2>
      </div><a class="text-link" href="/work/">All projects →</a>
    </div><div class="build-grid">
      {featured.map((project) => <ProjectCard {project} />)}
    </div>
  </section>
  <section
    class="home-writing page-pad section"
    aria-labelledby="writing-title"
  >
    <div class="section-heading">
      <div>
        <h2 id="writing-title">Recent writing</h2>
      </div><a class="text-link" href="/essays/">All writing →</a>
    </div><div class="writing-grid">
      {
        essays.slice(0, 3).map((essay, index) => (
          <article>
            <>
              <span class="writing-number">
                0{index + 1} / {essay.data.category}
              </span>
              <h3>
                <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
              </h3>
              <p>{essay.data.description}</p>
              <a class="text-link" href={`/essays/${essay.id}/`}>
                Read the essay →
              </a>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="home-video page-pad section" aria-labelledby="video-title">
    <div class="section-heading">
      <div>
        <h2 id="video-title">Videos</h2>
      </div><a
        class="text-link"
        href="https://www.youtube.com/@n1kmanue1"
        target="_blank"
        rel="noreferrer">My YouTube channel ↗</a
      >
    </div><div class="video-grid">
      {
        videos.map((video) => (
          <VideoEmbed
            id={video.id}
            title={video.title}
            description={video.description}
          />
        ))
      }
    </div>
  </section>
  <section class="home-now page-pad section" aria-labelledby="now-title">
    <div>
      <p class="label">Now · Updated {current.updated}</p><h2 id="now-title">
        Lately
      </h2>
    </div><div class="now-copy">
      <p>
        Building the businesses under Fresh Industries. Exploring
        infrastructure, Go, and Docker on my Linux server. Writing, making
        content, and experimenting with AI animation.
      </p><p class="now-small">
        Away from the keyboard: more workouts, Dark Matter, and smooth jazz—or a
        return to my 2016–2018 rap playlist.
      </p><a class="text-link" href="/current/">The full snapshot →</a>
    </div>
  </section>
  <section
    class="home-explore page-pad section"
    aria-labelledby="explore-title"
  >
    <div>
      <h2 id="explore-title">Notes and interests</h2><p>
        History, faith, design, attention, and how to live. Some ideas are ready
        for an essay. Others need more time.
      </p><a class="text-link" href="/explore/">Explore the rest →</a>
    </div><div class="explore-list">
      {
        notes.slice(0, 2).map((note) => (
          <a href={`/garden/${note.id}/`}>
            <>
              <span class="label label-muted">{note.data.maturity} note</span>
              <strong>{note.data.title}</strong>
            </>
          </a>
        ))
      }<a href="/principles/"
        ><span class="label label-muted">Principles</span><strong
          >Ideas I try to practice</strong
        ></a
      >
    </div>
  </section>
</BaseLayout>
<style>
  .home-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border-bottom: 1px solid var(--hairline-strong);
  }
  .hero-copy {
    padding: clamp(2rem, 4.5vw, 4.5rem) var(--page-pad);
  }
  .hero-copy h1 {
    max-width: 14ch;
    margin: 2rem 0 1.5rem;
    font: 430 clamp(3rem, 5vw, 5rem)/0.98 var(--font-display);
    letter-spacing: -0.045em;
  }
  .hero-intro {
    max-width: 35rem;
    font-size: clamp(1.08rem, 1.5vw, 1.25rem);
    line-height: 1.55;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.5rem;
    margin-top: 1.5rem;
  }
  .hero-links .text-link {
    font-size: 1.1rem;
  }
  .hero-aside {
    margin: 1.5rem 0 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
  }
  .hero-image {
    position: relative;
    margin: 0;
    min-width: 0;
    background: #093269;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 37rem;
  }
  .hero-image figcaption {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: var(--paper);
    padding: 0.4rem 0.65rem;
    font-size: 0.8rem;
  }
  .section-heading {
    display: flex;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }
  .section-heading h2,
  .home-now h2,
  .home-explore h2 {
    margin: 1rem 0 0;
    font: 450 clamp(2.2rem, 3.8vw, 3.8rem)/1.02 var(--font-display);
    letter-spacing: -0.035em;
  }
  .section-heading h2 {
    max-width: 21ch;
  }
  .section-heading > .text-link {
    flex: none;
  }
  .build-grid,
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2rem;
  }
  .home-writing,
  .home-video,
  .home-now,
  .home-explore {
    border-top: 1px solid var(--hairline-strong);
  }
  .home-writing {
    background: var(--paper-light);
  }
  .writing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .writing-grid article {
    border-top: 1px solid var(--hairline);
    padding-top: 1.25rem;
  }
  .writing-number {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .writing-grid h3 {
    font: 480 clamp(1.6rem, 2.5vw, 2.35rem)/1.1 var(--font-display);
    letter-spacing: -0.025em;
    margin: 1rem 0;
  }
  .writing-grid h3 a {
    text-decoration: none;
  }
  .writing-grid p {
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .writing-grid .text-link {
    font-size: 1.05rem;
  }
  .home-now {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    background: var(--ink);
    color: var(--paper-light);
  }
  .now-copy > p:first-child {
    font: 450 clamp(1.4rem, 2.3vw, 2rem)/1.4 var(--font-display);
  }
  .now-small {
    color: #d0d3ca;
  }
  .home-now .text-link:hover {
    color: #ffab85;
  }
  .home-explore {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .home-explore > div > p:not(.label) {
    max-width: 30rem;
    margin-top: 1.5rem;
    color: var(--ink-muted);
  }
  .explore-list a {
    display: grid;
    gap: 0.7rem;
    border-top: 1px solid var(--hairline);
    padding: 1.3rem 0;
    text-decoration: none;
  }
  .explore-list strong {
    font: 470 1.65rem/1.12 var(--font-display);
  }
  @media (max-width: 860px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
    .hero-copy h1 {
      max-width: 17ch;
    }
    .hero-image {
      max-height: 17rem;
      overflow: hidden;
    }
    .hero-image img {
      height: 17rem;
      object-position: center 70%;
    }
    .writing-grid {
      grid-template-columns: 1fr;
    }
    .home-now,
    .home-explore {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 620px) {
    .hero-copy {
      padding-block: 2rem;
    }
    .hero-copy h1 {
      font-size: clamp(2.8rem, 11.5vw, 3.8rem);
      margin: 1.5rem 0 1rem;
    }
    .hero-copy > .label {
      max-width: 24ch;
      line-height: 1.5;
    }
    .hero-links {
      margin-top: 1rem;
    }
    .hero-aside {
      margin-top: 1rem;
    }
    .hero-image {
      max-height: 12rem;
    }
    .hero-image img {
      height: 12rem;
    }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .build-grid,
    .video-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .home-explore {
      gap: 2rem;
    }
  }
</style>
