---
import PersonalMark from "@/components/PersonalMark.astro";
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
import { siteConfig } from "@/config";

const year = new Date().getFullYear();
---

<footer class="site-footer" id="connect">
  <div class="footer-main">
    <div class="footer-identity">
      <h2 class="label">Elsewhere</h2>
      <div class="footer-socials" aria-label="Find me elsewhere">
        {
          siteConfig.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer">
              {social.label}
              <ExternalLinkIcon />
            </a>
          ))
        }
      </div>
    </div>
    <nav aria-label="Secondary navigation">
      <a href="/garden/">Garden</a>
      <a href="/principles/">Principles</a>
      <a href="/commonplace/">Commonplace</a>
      <a href="/rss.xml">RSS feed</a>
    </nav>
  </div>
  <div class="footer-strip">
    <PersonalMark variant="orange" size="1rem" />
    <p>© {year} Nik Manuel</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline-strong);
    scroll-margin-top: 2rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.8fr);
    gap: 2rem;
    align-items: start;
    padding: clamp(2rem, 4vw, 3rem) var(--page-pad);
  }

  .footer-identity {
    display: grid;
    gap: 1rem;
  }

  .footer-identity h2 {
    margin: 0;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.88rem;
  }
  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
    justify-items: start;
  }

  nav a {
    min-height: 2.75rem;
    align-content: center;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .footer-strip {
    display: grid;
    min-height: 3.25rem;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    background: var(--orange);
    padding-inline: var(--page-pad);
    color: var(--ink);
  }

  .footer-strip p {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 590;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .footer-strip p:last-child {
    text-align: right;
  }

  @media (max-width: 680px) {
    .footer-main {
      grid-template-columns: 1fr;
      align-items: start;
    }

    nav {
      justify-items: start;
    }
  }
</style>
