<section class="project-demo" id="demo" aria-labelledby="demo-title">
  <div class="demo-heading">
    <p class="label">From the project</p>
    <h2 id="demo-title">Animation exported from Bara</h2>
    <p>
      A short animation from Bara. Compare its saved frames with a separate
      agent edit below.
    </p>
  </div>
  <div class="demo-surface" data-animation-viewer>
    <figure class="animation-export">
      <video
        controls
        playsinline
        preload="metadata"
        poster="/images/projects/bara-frame-00.webp"
        width="960"
        height="720"
        aria-label="A two-second arm wave exported from Bara"
      >
        <source src="/media/bara-arm-wave.mp4" type="video/mp4" />
        <a href="/media/bara-arm-wave.mp4"> Watch the exported animation </a>
      </video>
      <figcaption>Native MP4 export · 48 frames at 24 fps</figcaption>
    </figure>
    <figure class="animation-frame">
      <>
        <img
          src="/images/projects/bara-frame-00.webp"
          width="400"
          height="300"
          alt="A simple green character with an orange arm, exported from Bara"
          data-animation-frame
        />
        <figcaption data-frame-label>Saved sequence · frame 0</figcaption>
      </>
    </figure>
    <div class="demo-controls animation-controls">
      <>
        <label>
          Scrub the saved sequence
          <input type="range" name="frame" min="0" max="3" step="1" value="0" />
        </label>
        <label class="check-label">
          <input type="checkbox" name="agent-edit" /> Compare the saved agent edit
        </label>
      </>
    </div>
    <p class="demo-feedback" data-feedback aria-live="polite">
      The exported frames and the agent-edited frame remain separate files.
      Switch back at any time.
    </p>
    <p class="demo-footnote">
      These files were exported from the native app. The viewer displays them;
      editing happens in Bara.
    </p>
  </div>
  <noscript
    ><p class="demo-nojs">
      Enable JavaScript to compare the saved frames. The exported video and
      project story are still available.
    </p></noscript
  >
</section>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-animation-viewer]")
    .forEach((root) => {
      const frameInput =
        root.querySelector<HTMLInputElement>('[name="frame"]')!;
      const editInput = root.querySelector<HTMLInputElement>(
        '[name="agent-edit"]',
      )!;
      const image = root.querySelector<HTMLImageElement>(
        "[data-animation-frame]",
      )!;
      const label = root.querySelector<HTMLElement>("[data-frame-label]")!;
      const frames = ["00", "12", "23", "47"];
      const render = () => {
        const frame = frames[Number(frameInput.value)] ?? "00";
        image.src = `/images/projects/${editInput.checked ? "bara-agent-edit" : `bara-frame-${frame}`}.webp`;
        label.textContent = editInput.checked
          ? "Separate saved agent edit"
          : `Saved sequence · frame ${Number(frame)}`;
      };
      [frameInput, editInput].forEach((input) =>
        input.addEventListener("input", render),
      );
    });
</script>
