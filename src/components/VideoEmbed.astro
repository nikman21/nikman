---
import ExternalLinkIcon from "@/components/ExternalLinkIcon.astro";
interface Props {
  id: string;
  title: string;
  description?: string;
}
const { id, title, description } = Astro.props;
---

<figure class="video-figure">
  <div class="video-embed" data-video-id={id} data-video-title={title}>
    <button class="video-load" type="button" aria-label={`Play ${title}`}>
      <img
        src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
        alt=""
        width="480"
        height="360"
        loading="lazy"
      />
      <span>Play video</span>
    </button>
  </div>
  <figcaption>
    <strong>{title}</strong>{description && <p>{description}</p>}<a
      href={`https://www.youtube.com/watch?v=${id}`}
      target="_blank"
      rel="noreferrer">Watch on YouTube<ExternalLinkIcon /></a
    >
  </figcaption>
</figure>
<script>
  document
    .querySelectorAll<HTMLElement>(".video-embed")
    .forEach((container) => {
      container.querySelector("button")?.addEventListener(
        "click",
        () => {
          const frame = document.createElement("iframe");
          frame.src = `https://www.youtube-nocookie.com/embed/${container.dataset.videoId}?autoplay=1&rel=0`;
          frame.title = container.dataset.videoTitle ?? "YouTube video";
          frame.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          frame.allowFullscreen = true;
          frame.referrerPolicy = "strict-origin-when-cross-origin";
          container.replaceChildren(frame);
        },
        { once: true },
      );
    });
</script>
<style>
  .video-figure {
    margin: 0;
    min-width: 0;
  }
  .video-embed {
    aspect-ratio: 16/9;
    background: var(--ink);
    overflow: hidden;
    border: 1px solid var(--hairline);
  }
  .video-load {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: var(--ink);
    color: var(--paper-light);
  }
  .video-load img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-load > span {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: var(--ink);
    font-weight: 550;
  }
  .video-embed :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    padding-top: 1.2rem;
  }
  figcaption strong {
    display: block;
    font: 500 clamp(1.4rem, 2.3vw, 2rem)/1.15 var(--font-display);
  }
  figcaption p {
    margin: 0.6rem 0;
    color: var(--ink-muted);
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
  }
</style>
