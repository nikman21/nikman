---
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const openExternal =
  !project.data.demo &&
  !project.data.videoId &&
  Boolean(project.data.externalUrl);
const actionHref = openExternal
  ? project.data.externalUrl!
  : `/work/${project.id}/${project.data.demo ? "#demo" : project.data.videoId ? "#walkthrough" : ""}`;
---

<article class="build-card">
  <a
    class:list={[
      "project-visual",
      `project-visual--${project.id}`,
      { "project-visual--text": !project.data.image },
    ]}
    href={`/work/${project.id}/`}
    aria-label={`Explore ${project.data.title}`}
  >
    {
      project.data.image ? (
        <img
          src={project.data.image}
          alt={project.data.imageAlt ?? ""}
          width={project.data.imageWidth}
          height={project.data.imageHeight}
          loading="lazy"
          decoding="async"
        />
      ) : project.id === "fresh-infra" ? (
        <div class="package-preview">
          <>
            <span class="label">Fresh Infra</span>
            <p>
              Shared packages
              <br />
              for my apps
            </p>
            <ul>
              <>
                <li>Documents</li>
                <li>Files</li>
                <li>Bookings</li>
                <li>Payments</li>
              </>
            </ul>
            <span class="preview-caption">
              12 private packages · app-owned data
            </span>
          </>
        </div>
      ) : (
        <div class="text-preview">
          <>
            <span class="label">{project.data.eyebrow}</span>
            <p>{project.data.question ?? project.data.title}</p>
            <span>Explore the project →</span>
          </>
        </div>
      )
    }
  </a>
  <div class="card-copy">
    <div class="card-heading">
      <h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3><span
        class="stage">{project.data.stage}</span
      >
    </div><p>{project.data.description}</p><a
      class="text-link"
      href={actionHref}
      target={openExternal ? "_blank" : undefined}
      rel={openExternal ? "noreferrer" : undefined}
      >{
        project.data.demo
          ? "View the animation"
          : project.data.videoId
            ? "Watch the walkthrough"
            : openExternal
              ? `Open ${project.data.title}`
              : "Explore the project"
      }
      <span aria-hidden="true">{openExternal ? "↗" : "→"}</span></a
    >
  </div>
</article>
<style>
  .build-card {
    min-width: 0;
  }
  .project-visual {
    display: block;
    height: clamp(13rem, 23vw, 21rem);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: #ecebe4;
    text-decoration: none;
  }
  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .project-visual--text {
    height: auto;
    min-height: clamp(13rem, 23vw, 21rem);
  }
  .project-visual--text > div {
    min-height: inherit;
  }
  .project-visual--osef {
    background: #f8f6ed;
  }
  .project-visual--osef img {
    object-fit: contain;
  }
  .project-visual--inflatemate img {
    object-position: center;
    object-fit: contain;
  }
  .card-copy {
    padding-top: 1.25rem;
  }
  .card-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  h3 {
    margin: 0;
    font: 500 clamp(1.9rem, 3vw, 2.6rem)/1.05 var(--font-display);
    letter-spacing: -0.03em;
  }
  h3 a {
    text-decoration: none;
  }
  .stage {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .card-copy > p {
    max-width: 38rem;
    margin: 0.8rem 0 0.4rem;
    color: var(--ink-muted);
  }
  .text-link {
    gap: 0.7rem;
    font-size: 1.05rem;
  }
  .package-preview {
    height: 100%;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: #172b37;
    color: var(--paper-light);
    display: flex;
    flex-direction: column;
  }
  .package-preview > p {
    font: 430 clamp(1.7rem, 3vw, 2.7rem)/1.05 var(--font-display);
    letter-spacing: -0.025em;
    margin: 1rem 0;
  }
  .package-preview ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.82rem;
  }
  .preview-caption {
    margin-top: auto;
    padding-top: 1rem;
    color: #d5dcd9;
    font-size: 0.77rem;
  }
  .text-preview {
    height: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  .text-preview > p {
    margin: auto 0;
    padding: 1rem 0;
    font: 470 2rem/1.1 var(--font-display);
  }
  .text-preview > span:last-child {
    font-size: 0.85rem;
  }
</style>
